# ============================================
# CONFIGURATION SMTP (OBLIGATOIRE)
# ============================================
# Pour Gmail: https://myaccount.google.com/apppasswords
# Pour autres: consulter votre fournisseur

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=noreply@restaurant.com
SMTP_FROM_NAME=Restaurant Mulho

# ============================================
# EMAILS DE NOTIFICATION
# ============================================

ADMIN_EMAIL=admin@restaurant.com

# ============================================
# BASE DE DONNÉES (OPTIONNEL)
# ============================================
# Si vous voulez aussi déplacer les credentials DB ici

# DB_HOST=localhost
# DB_NAME=restaurant
# DB_USER=root
# DB_PASS=

# ============================================
# ENVIRONNEMENT
# ============================================

# Mode debug (true/false)
# ATTENTION: Désactiver en production!
DEBUG_MODE=false

# URL de base du site
BASE_URL=http://localhost/restaurant

# ============================================
# SÉCURITÉ
# ============================================

# Clé secrète pour le chiffrement (générer avec: openssl rand -base64 32)
# APP_SECRET=

# Durée de vie des sessions (secondes)
# SESSION_LIFETIME=3600

# ============================================
# APIS EXTERNES (SI UTILISÉES)
# ============================================

# Google Maps API
# GOOGLE_MAPS_API_KEY=

# ============================================
# PAIEMENT EN LIGNE
# ============================================

# -----------------
# Orange Money (Sénégal)
# -----------------
# Créer un compte développeur: https://developer.orange.com/
# Documentation: https://developer.orange.com/apis/orange-money-webpay/
ORANGE_MONEY_CLIENT_ID=your-client-id
ORANGE_MONEY_CLIENT_SECRET=your-client-secret
ORANGE_MONEY_MERCHANT_KEY=your-merchant-key

# -----------------
# Wave (Sénégal)
# -----------------
# Créer un compte marchand: https://developer.wave.com/
# Documentation: https://developer.wave.com/docs
WAVE_API_KEY=your-api-key
WAVE_API_SECRET=your-api-secret

# -----------------
# Paydunya (Cartes bancaires + Mobile Money)
# -----------------
# Créer un compte: https://paydunya.com/
# Documentation: https://paydunya.com/developers/
PAYDUNYA_MASTER_KEY=your-master-key
PAYDUNYA_PRIVATE_KEY=your-private-key
PAYDUNYA_PUBLIC_KEY=your-public-key
PAYDUNYA_TOKEN=your-token

# -----------------
# Stripe (International - Optionnel)
# -----------------
# Pour clients internationaux avec cartes VISA/Mastercard
# STRIPE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=

# -----------------
# Mode test paiement
# -----------------
# true = utiliser les API de test (sandbox)
# false = utiliser les API de production
PAYMENT_TEST_MODE=true

# ============================================
# NOTES
# ============================================
# 1. Copier ce fichier vers .env
# 2. Remplir les valeurs réelles
# 3. NE JAMAIS commiter le fichier .env dans Git!
# 4. Garder .env.example à jour quand vous ajoutez de nouvelles variables
